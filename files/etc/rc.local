# 1. 修复 PATH 环境变量
export PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:$PATH

# 定义路径
ROLE_PATH="/sys/class/udc/ci_hdrc.0/device/driver/ci_hdrc.0/role"
STATE_PATH="/sys/class/udc/ci_hdrc.0/state"

# 2. 开机先设为 device (gadget) 模式以触发状态检测
echo "gadget" > "$ROLE_PATH" 2>/dev/null

# 3. 等待硬件和主机完成握手枚举
# 如果 20 秒太长，建议先用 10-15 秒测试，稳定后再缩短
sleep 16

# 4. 获取当前状态并去除多余空格
STATUS=$(cat "$STATE_PATH" 2>/dev/null | xargs)

# 5. 核心逻辑判断
if [ "$STATUS" = "configured" ]; then
    echo "USB Status: [configured]. 已连接到主机，保持 Device 模式。"
else
    # 只要不是 configured（可能是 not attached, powered, addressed 等），就切到 host
    echo "USB Status: [$STATUS]. 未连接到有效主机，切换到 Host 模式..."
    echo "host" > "$ROLE_PATH"
    
    # 切换模式后稍作等待，重启网络以加载 Host 驱动下的网络配置
    sleep 2
    if [ -x /etc/init.d/network ]; then
        /etc/init.d/network restart
    fi
fi


# 开机强制切换USB为HOST模式
#echo host > /sys/class/udc/ci_hdrc.0/device/driver/ci_hdrc.0/role
# 可选：等USB稳定后重启网络，让RTL8152网卡识别
#sleep 2
#/etc/init.d/network restart

exit 0
