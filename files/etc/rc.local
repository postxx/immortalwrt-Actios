export PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:$PATH

# 定义相关路径
ROLE_PATH="/sys/class/udc/ci_hdrc.0/device/driver/ci_hdrc.0/role"
STATE_PATH="/sys/class/udc/ci_hdrc.0/state"

# 1. 开机先强制切到 device (gadget) 模式
# 加上错误重定向，防止路径不存在时报错
echo "gadget" > "$ROLE_PATH" 2>/dev/null

# 2. 等待 25 秒让硬件完成 VBUS 检测和枚举
# 25秒较保守，如果想开机更快，可以尝试缩短到 10-15s
sleep 25

# 3. 检测连接状态
# 使用 xargs 去除可能存在的换行符或空格
STATUS=$(cat "$STATE_PATH" 2>/dev/null | xargs)

# 只要状态包含 "not attached" 或者获取不到状态，就切到 host
if [ -z "$STATUS" ] || [ "$STATUS" = "not attached" ]; then
    echo "USB Status: [$STATUS]. 未检测到主机连接，切换到 Host 模式..."
    echo "host" > "$ROLE_PATH"
    
    # 给硬件层 2 秒切换电压和初始化总线的时间
    sleep 2
    
    # 重启网络（针对 Host 模式下的 USB 网卡驱动生效）
    if [ -x /etc/init.d/network ]; then
        /etc/init.d/network restart
    fi
else
    echo "USB Status: [$STATUS]. 检测到主机，保持 Device 模式。"
fi


# 开机强制切换USB为HOST模式
#echo host > /sys/class/udc/ci_hdrc.0/device/driver/ci_hdrc.0/role
# 可选：等USB稳定后重启网络，让RTL8152网卡识别
#sleep 2
#/etc/init.d/network restart

exit 0
